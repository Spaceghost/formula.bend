def fold_dispatch(ascii: Bool, c: Char, +code: U32) -> String:
  match ascii:
    case True{}:
      SCon{Char.to_lower(c), SNil{}}
    case False{}:
      fold_branch_1_188(U32.is_lt(code, 8073), code)

def fold_char(+c: Char) -> String:
  +code = Char.to_u32(c)
  fold_dispatch(U32.is_lt(code, 128), c, code)

def fold(text: String) -> String:
  match text:
    case SNil{}:
      SNil{}
    case SCon{c, rest}:
      fold_char(c) ++ fold(rest)

