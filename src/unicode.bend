def word_dispatch(ascii: Bool, +c: Char, +code: U32) -> Bool:
  match ascii:
    case True{}:
      Bool.or(Char.is_alpha(c), Bool.or(Char.is_digit(c), Char.is_eq(c, '_')))
    case False{}:
      word_node_383(U32.is_lt(code, 43793), U32.is_gt(code, 43798), code)

def is_word(+c: Char) -> Bool:
  +code = Char.to_u32(c)
  word_dispatch(U32.is_lt(code, 128), c, code)

