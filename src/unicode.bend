def lower_dispatch(ascii: Bool, c: Char, +code: U32) -> String:
  match ascii:
    case True{}:
      SCon{Char.to_lower(c), SNil{}}
    case False{}:
      lower_node_704(U32.is_lt(code, 7864), U32.is_gt(code, 7864), code)

def lower_char(+c: Char) -> String:
  +code = Char.to_u32(c)
  lower_dispatch(U32.is_lt(code, 128), c, code)

def lower(text: String) -> String:
  match text:
    case SNil{}:
      SNil{}
    case SCon{c, rest}:
      lower_char(c) ++ lower(rest)

