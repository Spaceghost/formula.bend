def fold_char(+c: Char) -> String:
  +code = Char.to_u32(c)
  choose_text(U32.is_lt(code, 128), u => String.to_lower(SCon{c, SNil{}}), u => fold_node_752(code))

def fold(text: String) -> String:
  match text:
    case SNil{}:
      SNil{}
    case SCon{c, rest}:
      fold_char(c) ++ fold(rest)

